#!/usr/bin/env bash
# Launch Claude Code on DeepSeek (via the local DeepSeek Bridge). Linux/macOS twin of dsclaude.cmd.
# Starts the bridge in the background if it is not already running (log: data/bridge.log).
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
PORT="${PORT:-8787}"
health() { curl -s -m "${1:-1}" "http://localhost:$PORT/health" >/dev/null 2>&1; }

if ! health 2; then
  echo "Starting DeepSeek Bridge..."
  mkdir -p "$ROOT/data"
  nohup node "$ROOT/bin/deepseek-bridge.js" --port "$PORT" --no-banner >>"$ROOT/data/bridge.log" 2>&1 &
  for _ in $(seq 20); do health && break; sleep 1; done
  if ! health; then
    echo "Bridge did not start. Run 'deepseek-bridge' to see the error (log: $ROOT/data/bridge.log)." >&2
    exit 1
  fi
fi

DSKEY="$(node -e 'console.log(require(process.argv[1]).apiKey)' "$ROOT/data/config.json")"

unset NO_COLOR
export FORCE_COLOR=1
export ANTHROPIC_BASE_URL="http://localhost:$PORT"
export ANTHROPIC_AUTH_TOKEN="$DSKEY"
export ANTHROPIC_MODEL=deepseek-chat
export ANTHROPIC_DEFAULT_MODEL=deepseek-chat
# Make every built-in alias (background tasks, subagents, plan mode) resolve to DeepSeek, never real Claude ids.
export ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-chat
export ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-reasoner
export ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-chat
export ANTHROPIC_DEFAULT_FABLE_MODEL=deepseek-reasoner
export CLAUDE_CODE_SUBAGENT_MODEL=deepseek-chat
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# assets/claude-settings.json defines the /model picker (exactly the 4 DeepSeek models).
# --allow-dangerously-skip-permissions only makes "bypass permissions" available in the Shift+Tab cycle; it does not start in it.
exec claude --allow-dangerously-skip-permissions --settings "$ROOT/assets/claude-settings.json" "$@"
